{
  "manifest_version": 3,
  "name": "NkapLingua — SAFINUM 2026",
  "version": "0.7.0",
  "description": "Traduction financière non intrusive en fulfulde, ewondo et duala. Détection FR/EN, backend local ou cloud expérimental.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nkaplingua@safinum.cm",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://api.mymemory.translated.net/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "NkapLingua",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "121",
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "languages.js",
        "content.js",
        "widget.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
